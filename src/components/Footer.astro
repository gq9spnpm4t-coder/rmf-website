---
import { site } from '../data/site';
---

<footer class="bg-ink text-paper">
  <div class="mx-auto max-w-6xl px-5 py-14 md:px-8">
    <div class="flex flex-col items-start justify-between gap-10 md:flex-row md:items-center">
      <a href="#top" class="block">
        <img src="/logo-white.png" alt="Ridenour Media Firm" class="h-12 w-auto md:h-14" />
      </a>
      <div class="space-y-2 text-sm text-paper/70">
        <p class="font-display font-semibold tracking-[0.1em] text-paper uppercase">
          {site.name} · {site.location}
        </p>
        <p>
          <a href={site.youtube.url} class="transition-colors hover:text-accent">
            YouTube {site.youtube.handle}
          </a>
          {' · '}
          <a href={site.instagram.url} class="transition-colors hover:text-accent">
            Instagram {site.instagram.handle}
          </a>
        </p>
        <p>
          Email:{' '}
          <a href={`mailto:${site.email}`} class="transition-colors hover:text-accent">
            {site.email}
          </a>
        </p>
      </div>
    </div>
  </div>
</footer>
