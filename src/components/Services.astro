---
import { services } from '../data/services';

// Inline line icons (Lucide-style), keyed by each service's `icon` field.
// Stroke-based to match the aperture / line-art look.
const icons: Record<string, string> = {
  zap: '<path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"/>',
  megaphone: '<path d="m3 11 18-5v12L3 14v-3z"/><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"/>',
  package:
    '<path d="M11 21.73a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73z"/><path d="M12 22V12"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="m7.5 4.27 9 5.15"/>',
  home: '<path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M9 22V12h6v10"/>',
  calendar:
    '<path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/>',
  film: '<rect width="18" height="18" x="3" y="3" rx="2"/><path d="M7 3v18"/><path d="M3 7.5h4"/><path d="M3 12h18"/><path d="M3 16.5h4"/><path d="M17 3v18"/><path d="M17 7.5h4"/><path d="M17 16.5h4"/>',
  graduation:
    '<path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"/><path d="M22 10v6"/><path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5"/>',
  user: '<path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>',
  monitor: '<rect width="20" height="14" x="2" y="3" rx="2"/><path d="M8 21h8"/><path d="M12 17v4"/>',
  layout: '<rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/>',
  mappin:
    '<path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/>',
  scissors:
    '<circle cx="6" cy="6" r="3"/><path d="M8.12 8.12 12 12"/><path d="M20 4 8.12 15.88"/><circle cx="6" cy="18" r="3"/><path d="M14.8 14.8 20 20"/>',
};
---

<section id="services" class="bg-paper">
  <div class="mx-auto max-w-6xl px-5 py-20 md:px-8 md:py-28">
    <h2 class="display reveal text-4xl md:text-5xl">What I can help with</h2>
    <p class="reveal mt-5 max-w-2xl text-lg leading-relaxed text-ink-soft">
      Ridenour Media Firm is a catch-all for visual media. If it comes down to a camera and a
      story, I can help. Pick the thing you need most right now, and we'll shape the rest
      together.
    </p>

    <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        services.map((service, i) => (
          <li
            class="reveal card-lift glint tilt group relative overflow-hidden rounded-lg border border-ink/10 bg-white"
            style={`--glint-delay: ${i * 1.9}s`}
          >
            <a
              href="#contact"
              class="service-card flex min-h-[132px] flex-col p-6 focus:outline-none"
              data-need={service.need}
              aria-label={`Start a project for ${service.name}`}
            >
              <div class="flex items-center justify-between gap-3">
                <h3 class="font-display text-2xl leading-none font-extrabold tracking-tight uppercase lg:text-[1.9rem]">
                  {service.short}
                </h3>
                <svg
                  class="h-8 w-8 shrink-0 text-ink/70 transition-colors duration-300 group-hover:text-accent"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <Fragment set:html={icons[service.icon] ?? ''} />
                </svg>
              </div>

              <p class="mt-3 translate-y-1 text-sm leading-snug text-ink-soft opacity-0 transition-all duration-300 group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:translate-y-0 group-focus-within:opacity-100">
                {service.blurb}
              </p>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  // Clicking a service card scrolls to the inquiry form and preselects the
  // matching need. The form owns the actual selection (see InquiryForm), so we
  // just broadcast which need was chosen.
  document.querySelectorAll<HTMLAnchorElement>('.service-card').forEach((card) => {
    card.addEventListener('click', () => {
      const need = card.dataset.need;
      if (need) {
        window.dispatchEvent(new CustomEvent('rmf:select-need', { detail: need }));
      }
    });
  });
</script>
