---
import { services } from '../data/services';
---

<section id="services" class="bg-paper">
  <div class="mx-auto max-w-6xl px-5 py-20 md:px-8 md:py-28">
    <h2 class="display reveal text-4xl md:text-5xl">What I can help with</h2>
    <p class="reveal mt-5 max-w-2xl text-lg leading-relaxed text-ink-soft">
      Ridenour Media Firm is a catch-all for visual media. If it comes down to a camera and a
      story, I can help. Pick the thing you need most right now, and we'll shape the rest
      together.
    </p>

    <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        services.map((service, i) => (
          <li
            class="reveal card-lift glint tilt group relative rounded-lg border border-ink/10 bg-white p-6"
            style={`--glint-delay: ${i * 1.9}s`}
          >
            <a
              href="#contact"
              class="service-card block focus:outline-none"
              data-need={service.need}
              aria-label={`Start a project for ${service.name}`}
            >
              <span
                class="bar-breathe block h-1 w-8 rounded-full bg-accent"
                style={`animation-delay: ${i * 0.45}s`}
              />
              <h3 class="mt-4 font-display text-sm font-bold tracking-[0.1em] uppercase">
                {service.name}
              </h3>
              <p class="mt-2 leading-relaxed text-ink-soft">{service.blurb}</p>
              <span class="mt-4 inline-flex items-center gap-1.5 font-display text-xs font-semibold tracking-[0.14em] text-accent uppercase opacity-0 transition-opacity duration-300 group-hover:opacity-100 group-focus-within:opacity-100">
                Start this project
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  // Clicking a service card scrolls to the inquiry form and preselects the
  // matching need. The form owns the actual selection (see InquiryForm), so we
  // just broadcast which need was chosen.
  document.querySelectorAll<HTMLAnchorElement>('.service-card').forEach((card) => {
    card.addEventListener('click', () => {
      const need = card.dataset.need;
      if (need) {
        window.dispatchEvent(new CustomEvent('rmf:select-need', { detail: need }));
      }
    });
  });
</script>
