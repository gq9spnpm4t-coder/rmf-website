---
---

<section id="top" class="relative overflow-hidden bg-paper">
  <!-- A huge aperture turns almost imperceptibly behind the headline -->
  <div
    class="pointer-events-none absolute top-1/2 -right-28 w-[26rem] -translate-y-1/2 opacity-[0.05] md:-right-20 md:w-[34rem]"
    aria-hidden="true"
  >
    <div data-cursor-lean style="transition: transform 0.5s ease-out;">
      <div data-scroll-rotate="0.06">
        <img src="/aperture.png" alt="" class="spin-slow w-full" />
      </div>
    </div>
  </div>

  <div class="relative mx-auto max-w-6xl px-5 pt-20 pb-16 md:px-8 md:pt-28 md:pb-20">
    <p class="eyebrow reveal text-accent">Tulsa-based video &amp; photo production</p>
    <h1 class="display reveal mt-6 max-w-4xl text-5xl sm:text-6xl md:text-7xl lg:text-8xl">
      Video and photo that make people <span class="focus-frame"><span class="text-accent">care.</span></span>
    </h1>
    <p class="reveal mt-8 max-w-2xl text-lg leading-relaxed text-ink-soft md:text-xl">
      I'm Junuh Ridenour, and if it involves a camera, I probably do it. I take your project from
      the first idea to the final file, with clean work, honest turnaround, and real attention to
      what you're building.
    </p>
    <div class="reveal mt-10 flex flex-wrap gap-4">
      <a
        href="#work"
        class="rounded-md border-2 border-ink px-7 py-3.5 font-display text-sm font-bold tracking-[0.14em] uppercase transition hover:-translate-y-0.5 hover:bg-ink hover:text-paper"
      >
        See the work
      </a>
      <a
        href="#contact"
        class="rounded-md bg-accent px-7 py-3.5 font-display text-sm font-bold tracking-[0.14em] text-white uppercase transition hover:-translate-y-0.5 hover:bg-accent-dark"
      >
        Start a project
      </a>
    </div>

    <div class="reveal mt-16 flex justify-center md:mt-20">
      <a href="#work" aria-label="Scroll to the work" class="float-soft text-ink/35 transition-colors hover:text-accent">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 9l6 6 6-6"></path>
        </svg>
      </a>
    </div>
  </div>
</section>
